From aed920a9b3612e95ba34c985378fbb653a7ed605 Mon Sep 17 00:00:00 2001
From: Mesanic <7865719+Mesanic@users.noreply.github.com>
Date: Wed, 23 Sep 2026 16:32:19 -0600
Subject: [PATCH 2/2] scan: --no-claude-md skips the CLAUDE.md routing block

For harnesses that already route to sextant (a plugin's own context, a
hand-written CLAUDE.md), a second routing text only drifts from the first.
--no-claude-md or SEXTANT_NO_CLAUDE_MD=1 skips it, mirroring --no-hook and
SEXTANT_NO_HOOK=1. Test: scripts/impact-fallback.test.mjs.
---
 README.md                        |  5 ++++-
 SKILL.md                         |  5 ++++-
 scripts/impact-fallback.test.mjs | 11 ++++++++---
 scripts/sextant.mjs              |  6 ++++--
 4 files changed, 20 insertions(+), 7 deletions(-)

diff --git a/README.md b/README.md
index cc61b84..c75eb74 100644
--- a/README.md
+++ b/README.md
@@ -59,7 +59,8 @@ matter; nothing is resolved by convention. Requires Node 20+ (developed on v22).
 
 `scan` creates two store directories at your repo root, appends to `.gitignore`, writes a
 routing block to `CLAUDE.md`, and installs a `PreToolUse` hook. It prints a line for each
-rather than editing your repo quietly. Skip the hook with `--no-hook`.
+rather than editing your repo quietly. Skip the hook with `--no-hook` and the block with
+`--no-claude-md`.
 
 ## The loop
 
@@ -149,6 +150,7 @@ sextant/
     session-hook.mjs    the session-start announcement (SessionStart)
     grep-nudge-hook.mjs one-shot "try query first" on a repo-wide grep
     merge.test.mjs      node scripts/merge.test.mjs <root>
+    impact-fallback.test.mjs  node --test scripts/impact-fallback.test.mjs
   engine/
     atlas/              file-graph engine + viewer
     scalpel/            symbol-graph engine + tree-sitter grammars
@@ -161,6 +163,7 @@ they give is reachable through `sextant`, so there is no second command surface
 
 ```bash
 node scripts/merge.test.mjs <a repo you have run `sextant scan` in>
+node --test scripts/impact-fallback.test.mjs   # builds its own fixture repo
 ```
 
 Asserts the property the merge exists to provide: symbols are reachable from the file
diff --git a/SKILL.md b/SKILL.md
index bc6e72a..3d5a200 100644
--- a/SKILL.md
+++ b/SKILL.md
@@ -156,7 +156,7 @@ node — docs, config, anything outside the graph — and in repos with no index
 - Entries expire after 2 hours (`SEXTANT_IMPACT_TTL_MIN`). An impact answer describes the
   graph as it was; half a day of edits later it is a claim about code that no longer exists.
 - Bypass one session with `SEXTANT_HOOK=off`. Skip installation with `sextant scan --no-hook`
-  or `SEXTANT_NO_HOOK=1`.
+  or `SEXTANT_NO_HOOK=1`; skip the `CLAUDE.md` block with `--no-claude-md` or `SEXTANT_NO_CLAUDE_MD=1`.
 - Deleting the hook from `settings.json` is not an opt-out — the next `scan` puts it back.
   That is the point of it. Use the env var.
 
@@ -195,6 +195,8 @@ routing block to `CLAUDE.md`. sextant prints a line saying so rather than editin
 quietly. The block is written only when absent — **an edited block is never reverted**.
 That asymmetry is deliberate: this runs on every scan, and silently undoing a routing rule
 someone tuned is worse than carrying a stale one. Delete the block to regenerate it.
+Skip it with `sextant scan --no-claude-md` or `SEXTANT_NO_CLAUDE_MD=1` when something else
+already routes to sextant.
 
 Skills are not scanned. Any directory below the root holding a `SKILL.md` — sextant itself
 and anything else vendored under `.claude/skills/`, `skills/` or `tools/` — is skipped
@@ -318,6 +320,7 @@ sextant/
     grep-nudge-hook.mjs one-shot "try query first" on a repo-wide grep
     impact-log.mjs      shared TTL bookkeeping for the gate
     merge.test.mjs      `node scripts/merge.test.mjs <root>`
+    impact-fallback.test.mjs  `node --test scripts/impact-fallback.test.mjs`
   engine/
     atlas/              file-graph engine + viewer
     scalpel/            symbol-graph engine + tree-sitter grammars
diff --git a/scripts/impact-fallback.test.mjs b/scripts/impact-fallback.test.mjs
index 208d933..80a3938 100644
--- a/scripts/impact-fallback.test.mjs
+++ b/scripts/impact-fallback.test.mjs
@@ -1,5 +1,6 @@
 // Files only the file graph knows (CSS, HTML): `impact` answers from the file graph and
-// records the impact entry, so the pre-edit gate can clear.
+// records the impact entry, so the pre-edit gate can clear. And `scan --no-claude-md`
+// leaves CLAUDE.md alone.
 //   node --test scripts/impact-fallback.test.mjs
 import { test } from 'node:test';
 import assert from 'node:assert/strict';
@@ -32,10 +33,14 @@ const logged = (root) => {
 };
 
 const root = fixture();
-const scan = sextant(root, 'scan', '--no-hook');
+const scan = sextant(root, 'scan', '--no-hook', '--no-claude-md');
 
-test('scan builds both graphs', () => {
+test('scan --no-claude-md writes no CLAUDE.md routing block', () => {
   assert.equal(scan.status, 0, scan.stderr);
+  assert.ok(fs.existsSync(path.join(root, '.atlas', 'graph', 'nodes.jsonl')));
+  assert.ok(fs.existsSync(path.join(root, '.map', 'index')));
+  assert.equal(fs.existsSync(path.join(root, 'CLAUDE.md')), false);
+  assert.equal(fs.existsSync(path.join(root, '.claude')), false);
 });
 
 test('impact on a CSS file answers from the file graph and records the entry', () => {
diff --git a/scripts/sextant.mjs b/scripts/sextant.mjs
index aab47dd..267d62c 100644
--- a/scripts/sextant.mjs
+++ b/scripts/sextant.mjs
@@ -55,6 +55,7 @@ write back / verify
 options
   --root <dir>   project root (default: cwd)
   --no-hook      scan: do not install the impact-first PreToolUse hook
+  --no-claude-md scan: do not write the CLAUDE.md routing block
   --depth <n>    impact / neighbors
   --out <file>   view: where to write the HTML
 
@@ -351,8 +352,9 @@ function cmdScan(root, { atlas, scalpel }) {
   if (scalpel) summarize('symbol graph ', run(scalpel, ['scan'], root, { merge: true }));
   if (atlas) summarize('file graph   ', run(atlas, ['scan'], root, { merge: true }));
   // Only with both tools present: the block routes impact and view through sextant, and
-  // neither works with one store.
-  if (atlas && scalpel) {
+  // neither works with one store. Skipped when something else already does the routing
+  // (a harness plugin, a hand-written CLAUDE.md): two routing texts disagree eventually.
+  if (atlas && scalpel && !process.env.SEXTANT_NO_CLAUDE_MD && !process.argv.includes('--no-claude-md')) {
     const wrote = ensureClaudeBlock(root);
     if (wrote) console.log(`CLAUDE.md ${wrote} sextant routing block (edit freely; delete it to regenerate)`);
   }
